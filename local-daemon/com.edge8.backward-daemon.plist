<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.edge8.backward-daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/REPLACE_USER/path/to/agent-control-center/local-daemon/main.py</string>
        <string>--config</string>
        <string>/Users/REPLACE_USER/path/to/agent-control-center/agent-workspaces/agent_registry.yaml</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_USER/path/to/agent-control-center</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/acc-backward-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/acc-backward-daemon.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
