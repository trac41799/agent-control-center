# Queue Configuration
QUEUE_PROVIDER=upstash          # upstash | postgres | redis | file
UPSTASH_REDIS_URL=https://your-instance.upstash.io
UPSTASH_REDIS_TOKEN=your-token-here
POSTGRES_URL=postgresql://user:pass@localhost:5432/acc

# Lark / Feishu
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=your-app-secret
LARK_VERIFY_TOKEN=your-verify-token
LARK_BASE_URL=https://open.larksuite.com/open-apis

# Slack
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Discord
DISCORD_PUBLIC_KEY=your-public-key
DISCORD_BOT_TOKEN=your-bot-token

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token

# Registry path (default: ./agent_registry.yaml)
# REGISTRY_PATH=./agent_registry.yaml

# Polling interval in seconds (default: 1)
# POLL_INTERVAL=1

# Default router adapter (default: claude)
# DEFAULT_ROUTER_ADAPTER=claude

# Default agent adapter (default: claude)
# DEFAULT_AGENT_ADAPTER=claude
